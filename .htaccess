# Protect secret configuration files and JSON data from direct HTTP access
<FilesMatch "^\.env|config\.secret\.php|\.(json|log|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
